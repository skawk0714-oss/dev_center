[
  {
    "id": "ws-project-manager",
    "label": "프로젝트관리 AI",
    "menu": "project_manager",
    "ai_tools": ["codex", "claude"],
    "default_project_id": "260614-dev-center",
    "allowed_files": [
      "data/projects.json",
      "project_manager.php",
      "project_detail.php",
      "scripts/launch_project.ps1",
      "templates/instructions/*.md"
    ],
    "do_not_touch": [
      "data/features.json",
      "data/lab_experiments.json",
      "data/prompts.json",
      "data/ai_workspaces.json",
      "knowledge.php",
      "lab.php",
      "prompts.php",
      "settings.php"
    ],
    "startup_prompt_template": "templates/ai_roles/project-manager.md",
    "validation_commands": [
      "php -l project_manager.php",
      "php -l project_detail.php"
    ]
  },
